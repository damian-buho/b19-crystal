build-essential
libevent-2.1-7                           # (no description)
libgc1                                   # conservative garbage collector for C and C++
libgmp-dev                               # GMP link files for Crystal `big`
libpcre2-8-0                             # New Perl Compatible Regular Expression Library- 8 bit runtime files
libpcre2-dev                             # PCRE2 dev headers (pkg-config .pc file so Crystal detects PCRE2)
libssl3t64                               # Secure Sockets Layer toolkit - shared libraries
libssl-dev                               # OpenSSL dev files (libcrypto.so link and pkg-config .pc for Crystal)
libjitterentropy3-dev                    # static libcrypto.a entropy source, named in its Libs.private
libzstd-dev                              # static libcrypto.a compression, named in its Libs.private
libxml2-dev                              # libxml2 link files for Crystal `xml`
libyaml-dev                              # libyaml link files for Crystal `yaml`
pkg-config
zlib1g-dev                               # zlib link files for Crystal `compress`
git                                      # fast, scalable, distributed revision control system
