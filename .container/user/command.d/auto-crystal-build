set -euo pipefail
# auto-crystal-build - build every binary artifact of the record for the host cell into its asset
# shellcheck source=/dev/null
. b19-i18n
TOOL="crystal-build"

if [[ $# -gt 0 ]]; then
    b19-log error "${TOOL}" "$(_p 'unknown argument %s, the artifact record says what to build' "$1")"
    exit 2
fi

host_os="$(uname -s)"; host_os="${host_os,,}"
case "$(uname -m)" in
    x86_64) host_arch=amd64 ;;
    aarch64) host_arch=arm64 ;;
    *) host_arch="$(uname -m)" ;;
esac
os="${TARGET_OS:-${host_os}}"
arch="${TARGET_ARCH:-${host_arch}}"
if [[ "${os}/${arch}" != "${host_os}/${host_arch}" ]]; then
    b19-log error "${TOOL}" "$(_p 'the %s/%s cell needs its own runner, Crystal links only for the %s/%s host' "${os}" "${arch}" "${host_os}" "${host_arch}")"
    exit 1
fi
uname_arch="$(uname -m)"

version=""
for source in GITHUB_REF_NAME M6E_VERSION git; do
    if [[ "${source}" == git ]]; then
        candidate="$(git describe --tags --always --dirty 2>/dev/null)" || candidate=""
    else
        candidate="${!source:-}"
    fi
    case "${candidate}" in
        '') continue ;;
        *[{}]*) b19-log warn "${TOOL}" "$(_p 'ignoring %s=%s, an unexpanded placeholder' "${source}" "${candidate}")"; continue ;;
    esac
    version="${candidate}"
    b19-log info "${TOOL}" "$(_p 'version %s from %s' "${version}" "${source}")"
    break
done
if [[ -z "${version}" ]]; then
    version=dev
    b19-log info "${TOOL}" "$(_p 'version %s, no ref, M6E_VERSION or git tag to read' "${version}")"
fi

# Flat lines read [i].key=value, so every field of one artifact shares its index
declare -A field=()
indexes=()
while IFS= read -r line; do
    [[ "${line}" == \[*\].*=* ]] || continue
    index="${line%%]*}"; index="${index#[}"
    key="${line#*].}"; key="${key%%=*}"
    field["${index}.${key}"]="${line#*=}"
    [[ "${key}" == path ]] && indexes+=("${index}")
done < <(pf-cli get --quiet --expand --format flat --default '' 'org.projectfile.artifacts{kind=binary}')
if [[ ${#indexes[@]} -eq 0 ]]; then
    b19-log warn "${TOOL}" "$(_p 'no kind: binary artifact in %s, nothing to build' "${PWD}")"
    exit 0
fi
project_os="$(pf-cli get --quiet --default '' org.projectfile.operating-system | paste --serial --delimiters=' ')"
project_arch="$(pf-cli get --quiet --default '' org.projectfile.architecture | paste --serial --delimiters=' ')"

retries="${B19_SHARDS_INSTALL_RETRIES:-3}"
attempt=1
until timeout "${B19_SHARDS_INSTALL_TIMEOUT:-300}" shards install 1>&2; do
    if (( attempt >= retries )); then
        b19-log error "${TOOL}" "$(_p 'shards install failed %s times, giving up' "${attempt}")"
        exit 1
    fi
    delay=$(( 2 ** attempt + RANDOM % 3 ))
    b19-log warn "${TOOL}" "$(_p 'shards install attempt %s failed, retrying in %s s' "${attempt}" "${delay}")"
    sleep "${delay}"
    attempt=$(( attempt + 1 ))
done

built=0
for index in "${indexes[@]}"; do
    path="${field[${index}.path]}"
    command="${field[${index}.command]:-$(basename "${path}")}"
    oses="${field[${index}.operating-system]:-${project_os}}"
    arches="${field[${index}.architecture]:-${project_arch}}"
    if [[ -n "${oses}" && " ${oses} " != *" ${os} "* ]] || [[ -n "${arches}" && " ${arches} " != *" ${arch} "* ]]; then
        b19-log info "${TOOL}" "$(_p '%s is not built for %s/%s, its record lists %s × %s' "${command}" "${os}" "${arch}" "${oses:-any}" "${arches:-any}")"
        continue
    fi
    excluded=no
    for (( j = 0; ; j++ )); do
        ex_os="${field[${index}.exclude[${j}].os]-}"
        ex_arch="${field[${index}.exclude[${j}].arch]-}"
        [[ -z "${ex_os}${ex_arch}" ]] && break
        [[ "${ex_os:-${os}}" == "${os}" && "${ex_arch:-${arch}}" == "${arch}" ]] && excluded=yes
    done
    if [[ "${excluded}" == yes ]]; then
        b19-log info "${TOOL}" "$(_p '%s excludes the %s/%s cell' "${command}" "${os}" "${arch}")"
        continue
    fi

    asset="${field[${index}.asset]:-{command\}-{os\}-{arch\}{ext\}}"
    asset="${asset//\{command\}/${command}}"
    asset="${asset//\{os\}/${os}}"
    asset="${asset//\{arch\}/${uname_arch}}"
    asset="${asset//\{ext\}/}"
    if [[ "${asset}" == *[{}]* ]]; then
        b19-log error "${TOOL}" "$(_p 'asset %s keeps a placeholder, only {command} {os} {arch} {ext} exist' "${asset}")"
        exit 1
    fi
    out="$(dirname "${path}")/${asset}"
    program="${field[${index}.package]:-src/${command}.cr}"
    if [[ ! -f "${program}" ]]; then
        b19-log error "${TOOL}" "$(_p 'program file %s not found, declare it as the artifact package' "${program}")"
        exit 1
    fi
    version_env="${field[${index}.version-env]:-}"
    if [[ -z "${version_env}" ]]; then
        version_env="${command^^}_VERSION"
        version_env="${version_env//-/_}"
    fi

    link=()
    static="${field[${index}.static]:-true}"
    # Static archives keep their own dependencies in Libs.private, which only pkg-config --static prints
    [[ "${static}" == true ]] && link=(--static --link-flags "$(pkg-config --static --libs libssl libxml-2.0)")

    mkdir --parents "$(dirname "${out}")"
    b19-log info "${TOOL}" "$(_p 'building %s %s for %s/%s from %s into %s, stamped through %s, static %s' "${command}" "${version}" "${os}" "${arch}" "${program}" "${out}" "${version_env}" "${static}")"
    env "${version_env}=${version}" crystal build "${program}" --release --no-debug "${link[@]}" --output "${out}" 1>&2
    built=$(( built + 1 ))
done

if [[ "${built}" -eq 0 ]]; then
    b19-log error "${TOOL}" "$(_p 'no binary artifact is built for %s/%s, the cell is outside the record' "${os}" "${arch}")"
    exit 1
fi
b19-log info "${TOOL}" "$(_p 'built %s binaries for %s/%s' "${built}" "${os}" "${arch}")"
